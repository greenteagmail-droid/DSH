{
  "name": "dsh-bionic-intelligence",
  "version": "1.0.0",
  "description": "Bionic Intelligence（仿生智能）— silent screen memory + floating question window for DSH: record your screen locally, ask about it in natural language, get a spoken answer. · 静默录屏 + 悬浮提问窗：本地记住屏幕，随时提问，语音回答。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bionic-intelligence",
    "screen-memory",
    "ocr",
    "speech",
    "floating-window",
    "ffmpeg",
    "llm"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "doctor": "node dist/index.js --doctor"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "examples",
    "scripts",
    "docs",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.7"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "SEE LICENSE IN LICENSE"
}
